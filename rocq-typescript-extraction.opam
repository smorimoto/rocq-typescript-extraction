# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Extraction of Rocq code to TypeScript"
description:
  "A Rocq plugin that extracts Rocq definitions to TypeScript, implemented as a new backend over the MiniML intermediate language of the standard extraction plugin."
maintainer: ["Sora Morimoto <sora@morimoto.io>"]
authors: ["Sora Morimoto <sora@morimoto.io>"]
license: "ISC"
homepage: "https://github.com/smorimoto/rocq-typescript-extraction"
bug-reports: "https://github.com/smorimoto/rocq-typescript-extraction/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.1"}
  "base" {>= "v0.17"}
  "stdio" {>= "v0.17"}
  "ppx_jane" {>= "v0.17"}
  "base_quickcheck" {with-test & >= "v0.17"}
  "ppx_js_style" {>= "v0.17"}
  "ppx_expect" {with-test & >= "v0.17"}
  "zarith"
  "rocq-runtime" {>= "9.3"}
  "rocq-core" {>= "9.3"}
  "rocq-stdlib" {with-test & >= "9.2"}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "ocaml-lsp-server" {with-dev-setup}
  "ocaml-index" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/smorimoto/rocq-typescript-extraction.git"
x-maintenance-intent: ["(latest)"]
