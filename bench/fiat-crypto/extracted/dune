(rocq.extraction
 (prelude Programs)
 (extracted_files fields.ts)
 (theories TypeScriptExtraction Crypto Rewriter Stdlib))

(rule
 (alias runtest)
 (action
  (progn
   (run sh %{dep:../../../test/no_assertions.sh} %{dep:fields.ts})
   (run
    bunx
    --no-install
    oxlint
    --config
    %{dep:../../../oxlint.config.ts}
    --deny-warnings
    %{dep:fields.ts})
   (run
    bunx
    --no-install
    oxfmt
    --config
    %{dep:../../../oxfmt.config.ts}
    --check
    %{dep:fields.ts}))))
