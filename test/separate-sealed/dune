; Sealed functors cross files: the consumer applies the solvers of
; solvers.ts, sealed with the module type of solver-sig.ts whose nested
; module is the parameter, in the body of a functor of its own and at its
; top level, and reads each alias type as the argument's with no cast.
; The theory SealedLibs, in ../sealed-libs, holds the two libraries.

(rocq.extraction
 (prelude SeparateSealed)
 (extracted_files
  separate-sealed.ts
  solvers.ts
  solver-sig.ts
  datatypes.ts
  nat.ts)
 (theories TypeScriptExtraction SealedLibs))

(rule
 (alias runtest)
 (action
  (progn
   (diff separate-sealed.expected.ts separate-sealed.ts)
   (diff solvers.expected.ts solvers.ts)
   (diff solver-sig.expected.ts solver-sig.ts)
   (diff datatypes.expected.ts datatypes.ts)
   (diff nat.expected.ts nat.ts))))

(rule
 (alias runtest)
 (action
  (run
   sh
   %{dep:../no_assertions.sh}
   %{dep:separate-sealed.ts}
   %{dep:solvers.ts}
   %{dep:solver-sig.ts}
   %{dep:datatypes.ts}
   %{dep:nat.ts})))

(rule
 (alias runtest)
 (action
  (progn
   (run
    bun
    oxlint
    --config
    %{dep:../../oxlint.config.ts}
    --deny-warnings
    %{dep:separate-sealed.ts}
    %{dep:solvers.ts}
    %{dep:solver-sig.ts}
    %{dep:datatypes.ts}
    %{dep:nat.ts})
   (run
    bun
    oxfmt
    --config
    %{dep:../../oxfmt.config.ts}
    --check
    %{dep:separate-sealed.ts}
    %{dep:solvers.ts}
    %{dep:solver-sig.ts}
    %{dep:datatypes.ts}
    %{dep:nat.ts}))))
