; Members named like methods of built-ins cross files: sorts.ts binds
; those of its own application after it, the consumer reaches them through
; the import, and the functor of nests.ts binds the member of a module
; nested in an application of its body from that module's object. The
; theory MemberLibs, in ../member-libs, holds the two libraries.

(rocq.extraction
 (prelude SeparateMembers)
 (extracted_files separate-members.ts sorts.ts nests.ts datatypes.ts)
 (theories TypeScriptExtraction MemberLibs))

(rule
 (alias runtest)
 (action
  (progn
   (diff separate-members.expected.ts separate-members.ts)
   (diff sorts.expected.ts sorts.ts)
   (diff nests.expected.ts nests.ts)
   (diff datatypes.expected.ts datatypes.ts))))

(rule
 (alias runtest)
 (action
  (run
   sh
   %{dep:../no_assertions.sh}
   %{dep:separate-members.ts}
   %{dep:sorts.ts}
   %{dep:nests.ts}
   %{dep:datatypes.ts})))

(rule
 (alias runtest)
 (action
  (progn
   (run
    bunx
    --no-install
    oxlint
    --config
    %{dep:../../oxlint.config.ts}
    --deny-warnings
    %{dep:separate-members.ts}
    %{dep:sorts.ts}
    %{dep:nests.ts}
    %{dep:datatypes.ts})
   (run
    bunx
    --no-install
    oxfmt
    --config
    %{dep:../../oxfmt.config.ts}
    --check
    %{dep:separate-members.ts}
    %{dep:sorts.ts}
    %{dep:nests.ts}
    %{dep:datatypes.ts}))))
