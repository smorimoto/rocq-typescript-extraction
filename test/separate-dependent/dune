; Members of a dependent type across files: the consumer applies a functor
; of dependent.ts whose body has one, and a functor over a module type
; that specifies one. The theory ThroughLibs, in ../through-libs, holds
; the library.

(rocq.extraction
 (prelude SeparateDependent)
 (extracted_files separate-dependent.ts dependent.ts datatypes.ts)
 (theories TypeScriptExtraction ThroughLibs))

(rule
 (alias runtest)
 (action
  (progn
   (diff separate-dependent.expected.ts separate-dependent.ts)
   (diff dependent.expected.ts dependent.ts)
   (diff datatypes.expected.ts datatypes.ts))))

(rule
 (alias runtest)
 (action
  (run
   sh
   %{dep:../no_assertions.sh}
   %{dep:separate-dependent.ts}
   %{dep:dependent.ts}
   %{dep:datatypes.ts})))

(rule
 (alias runtest)
 (action
  (progn
   (run
    bun
    oxlint
    --config
    %{dep:../../oxlint.config.ts}
    --deny-warnings
    %{dep:separate-dependent.ts}
    %{dep:dependent.ts}
    %{dep:datatypes.ts})
   (run
    bun
    oxfmt
    --config
    %{dep:../../oxfmt.config.ts}
    --check
    %{dep:separate-dependent.ts}
    %{dep:dependent.ts}
    %{dep:datatypes.ts}))))
