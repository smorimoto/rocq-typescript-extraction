(rocq.extraction
 (prelude Default)
 (extracted_files backtrace-default.out debug-default.out)
 (flags
  (:standard -test-mode))
 (theories TypeScriptExtraction))

(rocq.extraction
 (prelude Enabled)
 (extracted_files backtrace-enabled.out)
 (flags
  (:standard -test-mode))
 (theories TypeScriptExtraction))

(rule
 (alias runtest)
 (action
  (run
   sh
   %{dep:backtrace.sh}
   %{dep:backtrace-enabled.out}
   %{dep:backtrace-default.out}
   %{dep:debug-default.out})))
