; The stanzas of the extraction tests, generated by gen_dune.sh. The file
; is not named dune.inc because Oxfmt reflows .inc files as prose.

(include tests.dune)

(include cram.dune)

(cram
 (applies_to no_assertions)
 (deps no_assertions.sh))

(cram
 (applies_to gen-dune)
 (deps gen-dune.ts compcert/gen-dune.ts ../bench/fiat-crypto/gen-dune.ts))

(rule
 (deps
  gen_dune.sh
  (glob_files *.v))
 (action
  (with-stdout-to
   tests.dune.gen
   (run sh gen_dune.sh))))

(rule
 (alias runtest)
 (action
  (diff tests.dune tests.dune.gen)))

; The count of the word unknown in every golden may only go down: the
; script fails on a rise, and a fall changes the table, so the pin file
; has to be promoted with it.

(rule
 (deps
  no_unknown.sh
  no_unknown.expected
  (glob_files_rec *.expected.ts)
  (glob_files_rec *.expected.out))
 (action
  (with-stdout-to
   no_unknown.out
   (run sh no_unknown.sh no_unknown.expected))))

(rule
 (alias runtest)
 (action
  (diff no_unknown.expected no_unknown.out)))

; One tsc run checks every test directory, and the benchmarks, against the
; root tsconfig.json, whose dune copy sits at the root of the build
; directory.

(rule
 (alias runtest)
 (deps
  ../oxlint.config.ts
  (glob_files *.ts)
  (glob_files ../bench/*.ts)
  (glob_files ../bench/fiat-crypto/extracted/*.ts)
  (glob_files ../bench/fiat-crypto/*.ts)
  (glob_files ../bench/bigint/*.ts)
  (glob_files ../bench/number/*.ts)
  (glob_files ../bench/runtime/*.ts)
  (glob_files bin-nums/*.ts)
  (glob_files compcert/*.ts)
  (glob_files stdlib-bin-nums/*.ts)
  (glob_files docs/*.ts)
  (glob_files language/*.ts)
  (glob_files layout-gaps/*.ts)
  (glob_files miniml/*.ts)
  (glob_files reconstructed-dependencies/*.ts)
  (glob_files separate/*.ts)
  (glob_files separate-aliased/*.ts)
  (glob_files separate-aliases/*.ts)
  (glob_files separate-applied/*.ts)
  (glob_files separate-as-module/*.ts)
  (glob_files separate-dependent/*.ts)
  (glob_files separate-empty/*.ts)
  (glob_files separate-enclosing/*.ts)
  (glob_files separate-functors/*.ts)
  (glob_files separate-inside/*.ts)
  (glob_files separate-keys/*.ts)
  (glob_files separate-kinds/*.ts)
  (glob_files separate-known/*.ts)
  (glob_files separate-mapped/*.ts)
  (glob_files separate-members/*.ts)
  (glob_files separate-mentions/*.ts)
  (glob_files monolithic-mentions/*.ts)
  (glob_files separate-modules/*.ts)
  (glob_files separate-naming/*.ts)
  (glob_files separate-number/*.ts)
  (glob_files separate-bigint/*.ts)
  (glob_files separate-nested/*.ts)
  (glob_files separate-placed/*.ts)
  (glob_files separate-plain/*.ts)
  (glob_files separate-prefix/*.ts)
  (glob_files separate-primitives/*.ts)
  (glob_files separate-realisers/*.ts)
  (glob_files separate-results/*.ts)
  (glob_files separate-sealed/*.ts)
  (glob_files separate-shapes/*.ts)
  (glob_files separate-through/*.ts)
  (glob_files separate-types/*.ts)
  (glob_files separate-unary/*.ts)
  (glob_files single/*.ts))
 (action
  (run bun tsc -p %{dep:../tsconfig.json})))

(alias
 (name runtime)
 (deps
  compcert/reference.out
  ../bench/fiat-crypto/gen-dune.ts
  (glob_files ../bench/*.ts)
  (glob_files ../bench/bigint/*.ts)
  (glob_files ../bench/number/*.ts)
  (glob_files ../bench/runtime/*.ts)
  ../bench/fiat-crypto/extracted/fields.ts
  (glob_files_rec *.ts)))

; Run all runtime tests together beside the extracted modules.
; CI mode rejects missing snapshots instead of recording them.

(rule
 (alias runtest)
 (deps
  compcert/reference.out
  ../bench/fiat-crypto/gen-dune.ts
  (glob_files ../bench/*.ts)
  (glob_files ../bench/bigint/*.ts)
  (glob_files ../bench/number/*.ts)
  (glob_files ../bench/runtime/*.ts)
  ../bench/fiat-crypto/extracted/fields.ts
  (glob_files_rec *.ts))
 (action
  (chdir
   ..
   (setenv
    CI
    true
    (run bun test --timeout 60000 ./test)))))
