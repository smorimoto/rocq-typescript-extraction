; An application, in this file, of a nested functor reached through a
; functor of another file defined as an application.

(rocq.extraction
 (prelude SeparatePlaced)
 (extracted_files separate-placed.ts placed.ts datatypes.ts)
 (theories TypeScriptExtraction FixLibs))

(rule
 (alias runtest)
 (action
  (progn
   (diff separate-placed.expected.ts separate-placed.ts)
   (diff placed.expected.ts placed.ts)
   (diff datatypes.expected.ts datatypes.ts))))

(rule
 (alias runtest)
 (action
  (run
   sh
   %{dep:../no_assertions.sh}
   %{dep:separate-placed.ts}
   %{dep:placed.ts}
   %{dep:datatypes.ts})))

(rule
 (alias runtest)
 (action
  (progn
   (run
    bunx
    --no-install
    oxlint
    --config
    %{dep:../../oxlint.config.ts}
    --deny-warnings
    %{dep:separate-placed.ts}
    %{dep:placed.ts}
    %{dep:datatypes.ts})
   (run
    bunx
    --no-install
    oxfmt
    --config
    %{dep:../../oxfmt.config.ts}
    --check
    %{dep:separate-placed.ts}
    %{dep:placed.ts}
    %{dep:datatypes.ts}))))
