; TypeScript Separate Extraction writes one module per Rocq file, named in
; kebab-case: here separate.ts, which imports the Corelib types it uses
; from datatypes.ts and map from list-def.ts.

(rocq.extraction
 (prelude Separate)
 (extracted_files separate.ts datatypes.ts list-def.ts)
 (theories TypeScriptExtraction))

(rule
 (alias runtest)
 (action
  (progn
   (diff separate.expected.ts separate.ts)
   (diff datatypes.expected.ts datatypes.ts)
   (diff list-def.expected.ts list-def.ts))))

(rule
 (alias runtest)
 (action
  (run
   sh
   %{dep:../no_assertions.sh}
   %{dep:separate.ts}
   %{dep:datatypes.ts}
   %{dep:list-def.ts})))

(rule
 (alias runtest)
 (action
  (progn
   (run
    bun
    oxlint
    --config
    %{dep:../../oxlint.config.ts}
    --deny-warnings
    %{dep:separate.ts}
    %{dep:datatypes.ts}
    %{dep:list-def.ts})
   (run
    bun
    oxfmt
    --config
    %{dep:../../oxfmt.config.ts}
    --check
    %{dep:separate.ts}
    %{dep:datatypes.ts}
    %{dep:list-def.ts}))))
