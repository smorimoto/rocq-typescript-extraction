(rocq.extraction
 (prelude MatchDirective)
 (extracted_files
  MatchDirective1.out
  MatchDirective2.out
  MatchDirective3.out
  MatchDirective4.out
  MatchDirective5.out
  MatchDirective6.out
  MatchDirective7.out)
 (flags
  (:standard -test-mode))
 (theories TypeScriptExtraction))

(rule
 (alias runtest)
 (action
  (progn
   (diff MatchDirective1.expected.out MatchDirective1.out)
   (diff MatchDirective2.expected.out MatchDirective2.out)
   (diff MatchDirective3.expected.out MatchDirective3.out)
   (diff MatchDirective4.expected.out MatchDirective4.out)
   (diff MatchDirective5.expected.out MatchDirective5.out)
   (diff MatchDirective6.expected.out MatchDirective6.out)
   (diff MatchDirective7.expected.out MatchDirective7.out))))

