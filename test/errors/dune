; Negative tests. Each file ends in a Fail command, which succeeds only when
; the extraction command fails, so building the theory checks that every
; unsupported input is rejected.

(rocq.theory
 (name TypeScriptExtractionErrors)
 (modules
  (:standard
   \
   AmbiguousMention
   CurriedTypeVariance
   Existential
   FunctorAsFunctor
   Lost
   LostModule
   InsideModuleType
   MatchDirective
   ModuleType))
 (theories TypeScriptExtraction))

(rule
 (alias runtest)
 (deps
  (glob_files *.vo))
 (action (progn)))

; A file compiled in test mode prints the message that Fail caught, which
; Redirect writes to a .out file, compared with its golden, so the test
; pins the message and not only the failure.

(rocq.extraction
 (prelude ModuleType)
 (extracted_files ModuleType.out)
 (flags
  (:standard -test-mode))
 (theories TypeScriptExtraction))

(rule
 (alias runtest)
 (action
  (diff ModuleType.expected.out ModuleType.out)))

(rocq.extraction
 (prelude FunctorAsFunctor)
 (extracted_files FunctorAsFunctor.out)
 (flags
  (:standard -test-mode))
 (theories TypeScriptExtraction))

(rule
 (alias runtest)
 (action
  (diff FunctorAsFunctor.expected.out FunctorAsFunctor.out)))

