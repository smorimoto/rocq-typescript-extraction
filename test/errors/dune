(rocq.extraction
 (prelude CurriedTypeVariance)
 (extracted_files
  PositiveCurriedType.out
  NestedCurriedType.out
  ChangingCurriedType.out
  AlternatingCurriedType.out
  IndirectNegativeCurriedType.out
  InlineNegativeCurriedType.out
  NaturalNegativeCurriedType.out)
 (flags
  (:standard -test-mode))
 (theories TypeScriptExtraction Stdlib))

(rule
 (alias runtest)
 (action
  (progn
   (diff PositiveCurriedType.expected.out PositiveCurriedType.out)
   (diff NestedCurriedType.expected.out NestedCurriedType.out)
   (diff ChangingCurriedType.expected.out ChangingCurriedType.out)
   (diff AlternatingCurriedType.expected.out AlternatingCurriedType.out)
   (diff
    IndirectNegativeCurriedType.expected.out
    IndirectNegativeCurriedType.out)
   (diff
    InlineNegativeCurriedType.expected.out
    InlineNegativeCurriedType.out)
   (diff
    NaturalNegativeCurriedType.expected.out
    NaturalNegativeCurriedType.out))))
