; Keep documentation generation here so release archives need no test fixtures.

(rocq.extraction
 (prelude Tree)
 (extracted_files tree.ts)
 (theories TypeScriptExtraction))

(rocq.extraction
 (prelude Point)
 (extracted_files point.ts)
 (theories TypeScriptExtraction))

(rocq.extraction
 (prelude Loop)
 (extracted_files loop.ts)
 (theories TypeScriptExtraction))

(rule
 (alias runtest)
 (action
  (diff tree.expected.ts tree.ts)))

(rule
 (alias runtest)
 (action
  (diff point.expected.ts point.ts)))

(rule
 (alias runtest)
 (action
  (diff loop.expected.ts loop.ts)))

(rule
 (target getting-started.md)
 (deps Tree.v)
 (action
  (run cppo -n %{dep:../../docs/getting-started.cpp.md} -o %{target})))

(rule
 (alias runtest)
 (action
  (diff ../../docs/getting-started.md getting-started.md)))

(rule
 (target encoding.md)
 (deps point.ts)
 (action
  (run cppo -n %{dep:../../docs/encoding.cpp.md} -o %{target})))

(rule
 (alias runtest)
 (action
  (diff ../../docs/encoding.md encoding.md)))

(rule
 (alias runtest)
 (action
  (run
   sh
   %{dep:../no_assertions.sh}
   %{dep:tree.ts}
   %{dep:point.ts}
   %{dep:loop.ts})))

(rule
 (alias runtest)
 (action
  (progn
   (run
    bun
    oxlint
    --config
    %{dep:../../oxlint.config.ts}
    --deny-warnings
    %{dep:tree.ts}
    %{dep:point.ts}
    %{dep:loop.ts})
   (run
    bun
    oxfmt
    --config
    %{dep:../../oxfmt.config.ts}
    --check
    %{dep:tree.ts}
    %{dep:point.ts}
    %{dep:loop.ts}))))
