; The directives of mentions/Boxes written into one file, where Point and
; origin need no import.

(rocq.extraction
 (prelude MonolithicMentions)
 (extracted_files monolithic-mentions.ts)
 (theories TypeScriptExtraction Mentions))

(rule
 (alias runtest)
 (action
  (diff monolithic-mentions.expected.ts monolithic-mentions.ts)))

(rule
 (alias runtest)
 (action
  (run sh %{dep:../no_assertions.sh} %{dep:monolithic-mentions.ts})))

(rule
 (alias runtest)
 (action
  (progn
   (run
    bun
    oxlint
    --config
    %{dep:../../oxlint.config.ts}
    --deny-warnings
    %{dep:monolithic-mentions.ts})
   (run
    bun
    oxfmt
    --config
    %{dep:../../oxfmt.config.ts}
    --check
    %{dep:monolithic-mentions.ts}))))
