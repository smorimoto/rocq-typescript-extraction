; Applications through applications and parameters across files: the
; consumer applies, in full and in part, a functor of the body of a
; functor of outer.ts reached through an application of outer.ts, and
; applies the functor that a functor signature of outer.ts declares
; through an application of a parameter declared with it. The theory
; ThroughLibs, in ../through-libs, holds the library.

(rocq.extraction
 (prelude SeparateThrough)
 (extracted_files separate-through.ts outer.ts datatypes.ts)
 (theories TypeScriptExtraction ThroughLibs))

(rule
 (alias runtest)
 (action
  (progn
   (diff separate-through.expected.ts separate-through.ts)
   (diff outer.expected.ts outer.ts)
   (diff datatypes.expected.ts datatypes.ts))))

(rule
 (alias runtest)
 (action
  (run
   sh
   %{dep:../no_assertions.sh}
   %{dep:separate-through.ts}
   %{dep:outer.ts}
   %{dep:datatypes.ts})))

(rule
 (alias runtest)
 (action
  (progn
   (run
    bun
    oxlint
    --config
    %{dep:../../oxlint.config.ts}
    --deny-warnings
    %{dep:separate-through.ts}
    %{dep:outer.ts}
    %{dep:datatypes.ts})
   (run
    bun
    oxfmt
    --config
    %{dep:../../oxfmt.config.ts}
    --check
    %{dep:separate-through.ts}
    %{dep:outer.ts}
    %{dep:datatypes.ts}))))
