; Type lambdas across files: the consumer declares a functor over a module
; type of kinds.ts whose abstract type takes a parameter, and applies it
; and a functor of kinds.ts to a module of kinds.ts, so the lambda extends
; the TypeLambda that kinds.ts declares. The theory ThroughLibs, in
; ../through-libs, holds the library.

(rocq.extraction
 (prelude SeparateKinds)
 (extracted_files separate-kinds.ts kinds.ts datatypes.ts nat.ts)
 (theories TypeScriptExtraction ThroughLibs))

(rule
 (alias runtest)
 (action
  (progn
   (diff separate-kinds.expected.ts separate-kinds.ts)
   (diff kinds.expected.ts kinds.ts)
   (diff datatypes.expected.ts datatypes.ts)
   (diff nat.expected.ts nat.ts))))

(rule
 (alias runtest)
 (action
  (run
   sh
   %{dep:../no_assertions.sh}
   %{dep:separate-kinds.ts}
   %{dep:kinds.ts}
   %{dep:datatypes.ts}
   %{dep:nat.ts})))

(rule
 (alias runtest)
 (action
  (progn
   (run
    bunx
    --no-install
    oxlint
    --config
    %{dep:../../oxlint.config.ts}
    --deny-warnings
    %{dep:separate-kinds.ts}
    %{dep:kinds.ts}
    %{dep:datatypes.ts}
    %{dep:nat.ts})
   (run
    bunx
    --no-install
    oxfmt
    --config
    %{dep:../../oxfmt.config.ts}
    --check
    %{dep:separate-kinds.ts}
    %{dep:kinds.ts}
    %{dep:datatypes.ts}
    %{dep:nat.ts}))))
